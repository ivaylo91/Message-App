<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability: FCM delivers through APNs on iOS.
	     EAS reads this file when it sets up the App ID, and export re-signs
	     it as "production" for App Store/TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
