<!--
  Status-bar icon for every notification this app posts.

  Android uses only the ALPHA channel of a small icon - it is drawn as a
  silhouette, tinted by the notification's accent colour - so this is a
  solid shape with the flame's inner cut-out punched out via evenOdd
  rather than a coloured image. Supplying the launcher icon here (which is
  what happens when no smallIcon is set) produces the familiar white or
  grey blob, because a full-colour image flattens to a filled rectangle.

  A vector rather than PNGs so one file covers every density.

  The path traces src/assets/flame-mark.png: a notched flame with a taller
  left peak, and a smaller flame-shaped hole in the body.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M9.8,0.8
                          C9.8,0.8 1.2,8.6 1.2,14.2
                          C1.2,19.2 6.0,23.2 12.0,23.2
                          C18.0,23.2 22.8,19.2 22.8,14.2
                          C22.8,10.4 19.6,6.0 17.0,3.4
                          C16.0,5.6 14.8,6.4 14.0,5.4
                          C12.6,3.6 11.0,1.8 9.8,0.8
                          Z
                          M11.6,9.4
                          C11.6,9.4 6.6,13.0 6.6,16.6
                          C6.6,19.2 9.0,21.2 12.0,21.2
                          C15.0,21.2 17.4,19.2 17.4,16.6
                          C17.4,15.2 16.9,13.9 16.1,12.9
                          C15.5,14.3 14.7,14.8 14.1,14.1
                          C13.2,13.0 12.3,10.4 11.6,9.4
