<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" stops cloud backup, but from Android 12 it doesn't stop
     device-to-device transfer, which would copy drafts and caches to another
     phone. This rules out both. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
