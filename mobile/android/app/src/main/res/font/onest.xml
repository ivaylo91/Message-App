<?xml version="1.0" encoding="utf-8"?>
<!-- Onest as one family, so React Native's fontWeight picks the right file.
     Registered as "Onest" in MainApplication. -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font app:fontStyle="normal" app:fontWeight="400" app:font="@font/onest_regular" />
    <font app:fontStyle="normal" app:fontWeight="500" app:font="@font/onest_medium" />
    <font app:fontStyle="normal" app:fontWeight="600" app:font="@font/onest_semibold" />
    <font app:fontStyle="normal" app:fontWeight="700" app:font="@font/onest_bold" />
    <font app:fontStyle="normal" app:fontWeight="800" app:font="@font/onest_extrabold" />
</font-family>
